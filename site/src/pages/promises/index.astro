---
import Base from '../../layouts/Base.astro';
import TargetRow from '../../components/TargetRow.astro';
import VerdictPill from '../../components/VerdictPill.astro';
import { url } from '../../config/site';
import DeliveryRow from '../../components/DeliveryRow.astro';
import { GOV_TARGETS, TARGETS, DELIVERIES, DELIVERIES_VERIFIED, tally } from '../../lib/measures';
import { fmtDate } from '../../lib/format';
import { VERDICT_MEANING } from '../../lib/editorial';
import type { Verdict } from '../../lib/types';
const t = tally(); const official = TARGETS.filter((m) => m.ed.target!.owner === 'official');
const order: Verdict[] = ['met', 'on_track', 'in_progress', 'at_risk', 'off_track', 'not_met'];
---
<Base title="The promises" description="Every measurable commitment the UK government made, judged against official figures under a published rule." section="promises/">
  <div class="wrap pt-10 md:pt-14">
    <p class="eyebrow">Commitments tracker</p>
    <h1 class="display mt-2 text-[clamp(34px,4.6vw,52px)]">Is the government doing what it said it would?</h1>
    <p class="lede mt-3">A promise is tracked here only if the government made it itself, it has a number, a date or a clear yes-or-no in it, and an official source can test it. {t.total} are tracked: <b>{t.good}</b> met or on track, <b>{t.progress}</b> in progress, <b>{t.risk}</b> at risk and <b>{t.bad}</b> off track or not met. More are added as they are verified.</p>
    <div class="mt-5 flex h-3 max-w-[640px] gap-[2px] overflow-hidden rounded-full" role="img" aria-label={`${t.good} met or on track, ${t.progress} in progress, ${t.risk} at risk, ${t.bad} off track or not met`}>
      {[[t.good, 'var(--good)'], [t.progress, 'var(--ink-3)'], [t.risk, 'var(--warn)'], [t.bad, 'var(--bad)']].filter(([n]) => n).map(([n, c]) => <span style={`flex:${n};background:${c}`} />)}
    </div>

    <h2 class="h2 mt-14">Judged on the running figures</h2>
    <p class="mt-2 max-w-[70ch] text-ink-2">These promises have a number that official statistics update, so the verdict can change whenever new figures land.</p>
    <div class="mt-6 grid gap-4">{GOV_TARGETS.map((m, i) => <TargetRow m={m} i={i} />)}</div>

    <h2 class="h2 mt-14">Judged on delivery</h2>
    <p class="mt-2 max-w-[70ch] text-ink-2">These were promises to do a specific thing: pass a law, set up a body, make a payment. Each was checked against its source on {fmtDate(DELIVERIES_VERIFIED)}. “Met” means the thing was delivered, not that it worked: whether a policy is a good idea is for you to judge.</p>
    <div class="mt-6 grid gap-4">{DELIVERIES.map((d, i) => <DeliveryRow d={d} i={i} />)}</div>
    {official.length > 0 && <div class="mt-12"><h2 class="h2">Official targets set by others</h2><p class="mt-2 max-w-[70ch] text-ink-2">Shown for reference. These don’t count in the government’s tally because the government doesn’t control them.</p><div class="mt-5 grid gap-4">{official.map((m, i) => <TargetRow m={m} i={i} />)}</div></div>}
    <section class="mt-16 max-w-[820px]">
      <h2 class="h2">What each verdict means</h2>
      <dl class="mt-5 grid gap-4">{order.map((v) => <div class="grid gap-1.5 sm:grid-cols-[150px_1fr] sm:items-start"><dt><VerdictPill verdict={v} /></dt><dd class="text-[15.5px] text-ink-2">{VERDICT_MEANING[v]}</dd></div>)}</dl>
      <p class="mt-6 text-[15.5px] text-ink-2">Every rule is published in full on the <a href={url('methodology/')}>methodology page</a>. Think a promise is missing, or a verdict is wrong? <a href={url('corrections/')}>Tell us</a> and we’ll check it against the source.</p>
    </section>
  </div>
</Base>
